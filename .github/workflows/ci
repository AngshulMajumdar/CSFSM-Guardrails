name: CI
on: [push, pull_request]
permissions:
  contents: read
jobs:
  test:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python: ['3.11', '3.12']
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python }}
      - run: pip install -e '.[api,space,dev,langchain,langgraph]'
      - run: ruff check .
      - run: ruff format --check .
      - run: pytest --cov=csfsm_guardrails --cov-report=xml
      - run: python -m build
      - run: python scripts/build_space.py --output build/hf-space
      - uses: actions/upload-artifact@v4
        with:
          name: distributions-${{ matrix.python }}
          path: dist/*
